# Copy to .env and fill in your values.
# Sonarr > Settings > General > API Key
SONARR_URL=http://192.168.1.50:8989
SONARR_API_KEY=replace-with-your-sonarr-api-key

# Interface/port the MCP server listens on inside the container.
MCP_HOST=0.0.0.0
MCP_PORT=8931

# Shared secret required as `Authorization: Bearer <token>` on every request.
# Leave unset to run with no auth (anyone who can reach the port can call
# every tool). Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
